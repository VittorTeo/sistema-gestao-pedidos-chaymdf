rules_version = '2';

// Regras do Cloud Firestore · Sistema de Gestão de Pedidos ChayMDF
//
// Acesso restrito a funcionários: a pessoa precisa estar logada
// (Firebase Authentication, e-mail/senha) E ter um documento em
// /funcionarios/{UID} — criado pelo administrador no console.
// Para tirar o acesso de alguém: apague o documento dela em
// "funcionarios" ou desative o usuário no Authentication.
service cloud.firestore {
  match /databases/{database}/documents {

    function ehFuncionario() {
      return request.auth != null
        && exists(/databases/$(database)/documents/funcionarios/$(request.auth.uid));
    }

    function statusValido(s) {
      return s in ['lancamento', 'andamento', 'finalizados'];
    }

    function pedidoValido(d) {
      return d.keys().hasOnly(['nome', 'descricao', 'quantidade', 'prazo', 'status', 'criadoEm'])
        && d.keys().hasAll(['nome', 'descricao', 'quantidade', 'prazo', 'status', 'criadoEm'])
        && d.nome is string && d.nome.size() > 0 && d.nome.size() <= 200
        && d.descricao is string && d.descricao.size() > 0 && d.descricao.size() <= 2000
        && d.quantidade is int && d.quantidade >= 1 && d.quantidade <= 100000
        && d.prazo is string && d.prazo.matches('^[0-9]{2}/[0-9]{2}/[0-9]{4} [0-9]{2}:[0-9]{2}$')
        && statusValido(d.status);
    }

    match /pedidos/{pedidoId} {
      allow read: if ehFuncionario();

      // Novo pedido: formato válido, sempre em "lancamento", data do servidor
      allow create: if ehFuncionario()
        && pedidoValido(request.resource.data)
        && request.resource.data.status == 'lancamento'
        && request.resource.data.criadoEm == request.time;

      // Mover entre colunas: só o campo "status" pode mudar
      allow update: if ehFuncionario()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])
        && statusValido(request.resource.data.status);

      allow delete: if ehFuncionario();
    }

    // Lista de funcionários: administrada só pelo console do Firebase
    match /funcionarios/{uid} {
      allow read, write: if false;
    }

    // Qualquer outra coleção fica bloqueada
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
